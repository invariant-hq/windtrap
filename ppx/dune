; The rewriter is a desugaring into the core and the runtime's registry, so
; windtrap, the runtime and the config module are all ppx_runtime_libraries;
; the inline_tests backend's generated main runs a partition through
; Ppx_runtime under --corrected. See doc/dev/architecture.md, "Package map".

(library
 (name ppx_windtrap)
 (public_name ppx_windtrap)
 (kind ppx_rewriter)
 (libraries ppxlib)
 (ppx_runtime_libraries windtrap ppx_windtrap.runtime ppx_windtrap.config)
 (preprocess
  (pps ppxlib.metaquot))
 (inline_tests.backend
  (runner_libraries ppx_windtrap.runtime)
  (generate_runner
   (progn
    (echo "let () = Ppx_windtrap_runtime.Ppx_runtime.init Sys.argv;;")
    (echo "let () = Ppx_windtrap_runtime.Ppx_runtime.exit ();;")))
  (list_partitions_flags
   "inline-test-runner"
   %{library-name}
   -list-partitions)
  (flags "inline-test-runner" %{library-name} -partition %{partition})))
