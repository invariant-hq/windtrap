; The ppx_windtrap rewriter and the dune inline_tests backend. The
; rewriter is a desugaring into the core: generated code names
; Windtrap.test, expect, expect_exact and output, the runtime's registry,
; and the top-level Expect_test_config module (matching ppx_expect), so
; all three are its ppx_runtime_libraries. dune builds one runner per
; library from generate_runner, then drives it with the
; inline-test-runner protocol; Ppx_runtime interprets the flags and runs
; the partition through the one Windtrap.run, under --corrected.

(library
 (name ppx_windtrap)
 (public_name ppx_windtrap)
 (kind ppx_rewriter)
 (libraries ppxlib)
 (ppx_runtime_libraries windtrap ppx_windtrap.runtime ppx_windtrap.config)
 (preprocess
  (pps ppxlib.metaquot))
 (inline_tests.backend
  (runner_libraries ppx_windtrap.runtime)
  (generate_runner
   (progn
    (echo "let () = Ppx_windtrap_runtime.Ppx_runtime.init Sys.argv;;")
    (echo "let () = Ppx_windtrap_runtime.Ppx_runtime.exit ();;")))
  (list_partitions_flags
   "inline-test-runner"
   %{library-name}
   -list-partitions)
  (flags "inline-test-runner" %{library-name} -partition %{partition})))
