; The expression-grade coverage instrumenter, exposed as the dune
; instrumentation backend selected by
; --instrument-with ppx_windtrap.coverage: one library naming itself in
; (instrumentation.backend), as ppx/mutate/dune does. Its
; ppx_runtime_libraries name only the stdlib-only windtrap.runtime the
; generated code calls, so instrumented user code never pulls the
; windtrap core into its closure. Also usable directly with
; (preprocess (pps ppx_windtrap.coverage)), which the semantics tests
; rely on.

(library
 (name windtrap_coverage_ppx)
 (public_name ppx_windtrap.coverage)
 (kind ppx_rewriter)
 (libraries ppxlib)
 (ppx_runtime_libraries windtrap.runtime)
 (instrumentation.backend
  (ppx ppx_windtrap.coverage))
 (preprocess
  (pps ppxlib.metaquot)))
