; The coverage backend names itself in (instrumentation.backend) and lists
; only the stdlib-only runtime in ppx_runtime_libraries, so instrumented code
; never links the core; also usable through (pps). See doc/dev/testing.md,
; "Windtrap under its own instrumentation".

(library
 (name windtrap_coverage_ppx)
 (public_name ppx_windtrap.coverage)
 (kind ppx_rewriter)
 (libraries ppxlib)
 (ppx_runtime_libraries windtrap.runtime)
 (instrumentation.backend
  (ppx ppx_windtrap.coverage))
 (preprocess
  (pps ppxlib.metaquot)))
