; Masked-assertion regression (guarantee 9): an expect body that fails an
; assertion AND leaves a stale payload must exit nonzero and record no
; correction. Windtrap.subtest records the failure and carries on, so the
; body reaches the stale node; a run that treated the mismatch as a
; promotable correction would exit 0, dune would stage it, and dune
; promote would bless output the assertion already rejected.
; runner_main.exe mirrors the inline_tests backend's generated runner;
; ../drive/drive.exe spawns it with the protocol argv under a scrubbed
; environment and records the transcript and the exit code. The goldens
; pin the reported assertion failure, the withheld correction and exit 1.

(executable
 (name runner_main)
 (modules runner_main inline_masked_failure)
 (libraries windtrap ppx_windtrap.runtime)
 (preprocess
  (pps ppx_windtrap)))

(rule
 (targets runner-log runner-exit)
 (deps inline_masked_failure.ml)
 (action
  (run
   %{dep:../drive/drive.exe}
   --mask
   full-log
   --env
   WINDTRAP_SLOW_THRESHOLD=0
   --run
   runner
   %{dep:runner_main.exe}
   inline-test-runner
   masked_failure)))

(rule
 (alias runtest)
 (action
  (diff runner-log.expected runner-log)))

(rule
 (alias runtest)
 (action
  (diff runner-exit.expected runner-exit)))
