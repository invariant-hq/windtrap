(executable
 (name expect_pp)
 (modules expect_pp)
 (libraries ppxlib ppx_windtrap))

; A new fixture is one X.ml and one X.expected, then dune build @gen-rules
; --auto-promote. A reject_* fixture must exit 1, and its whole output is its
; golden.

(include dune.inc)

(rule
 (deps
  (glob_files *.ml))
 (action
  (with-stdout-to
   dune.inc.gen
   (run ../gen/gen_dune.exe rules expect_pp.exe %{deps}))))

(rule
 (alias gen-rules)
 (action
  (diff dune.inc dune.inc.gen)))

(alias
 (name runtest)
 (deps
  (alias gen-rules)))

(rule
 (with-stdout-to
  cookie_disabled.actual
  (run
   ./expect_pp.exe
   -cookie
   "inline_tests=\"disabled\""
   --impl
   %{dep:expect_basic.ml})))

(rule
 (alias runtest)
 (action
  (diff cookie_disabled.expected cookie_disabled.actual)))

(rule
 (with-stdout-to
  cookie_enabled.actual
  (run
   ./expect_pp.exe
   -cookie
   "inline_tests=\"enabled\""
   --impl
   %{dep:test_basic.ml})))

(rule
 (alias runtest)
 (action
  (diff test_basic.expected cookie_enabled.actual)))

(rule
 (target cookie_invalid.actual)
 (action
  (with-outputs-to
   cookie_invalid.actual
   (with-accepted-exit-codes
    1
    (run
     ./expect_pp.exe
     -cookie
     "inline_tests=\"bogus\""
     --impl
     %{dep:test_basic.ml})))))

(rule
 (alias runtest)
 (action
  (diff cookie_invalid.expected cookie_invalid.actual)))

(rule
 (with-stdout-to
