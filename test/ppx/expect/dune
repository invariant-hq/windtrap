; Expansion and rejection goldens for ppx_windtrap: expect_pp.exe is a
; standalone ppxlib driver and the fixtures are never compiled. Accept with
; dune promote. See doc/dev/testing.md, "Accepting a golden".

(executable
 (name expect_pp)
 (modules expect_pp)
 (libraries ppxlib ppx_windtrap))

; dune.inc holds one golden rule pair per fixture, written by
; ../gen/gen_dune.exe from the list of .ml files here: a new fixture is one
; X.ml and one X.expected, then dune build @gen-rules --auto-promote. A
; reject_* fixture must exit 1, and its whole output is its golden.

(include dune.inc)

(rule
 (deps
  (glob_files *.ml))
 (action
  (with-stdout-to
   dune.inc.gen
   (run ../gen/gen_dune.exe rules expect_pp.exe %{deps}))))

(rule
 (alias gen-rules)
 (action
  (diff dune.inc dune.inc.gen)))

(alias
 (name runtest)
 (deps
  (alias gen-rules)))

; The inline_tests cookie, over the fixtures above.

(rule
 (with-stdout-to
  cookie_disabled.actual
  (run
   ./expect_pp.exe
   -cookie
   "inline_tests=\"disabled\""
   --impl
   %{dep:expect_basic.ml})))

(rule
 (alias runtest)
 (action
  (diff cookie_disabled.expected cookie_disabled.actual)))

(rule
 (with-stdout-to
  cookie_enabled.actual
  (run
   ./expect_pp.exe
   -cookie
   "inline_tests=\"enabled\""
   --impl
   %{dep:test_basic.ml})))

(rule
 (alias runtest)
 (action
  (diff test_basic.expected cookie_enabled.actual)))

(rule
 (target cookie_invalid.actual)
 (action
  (with-outputs-to
   cookie_invalid.actual
   (with-accepted-exit-codes
    1
    (run
     ./expect_pp.exe
     -cookie
     "inline_tests=\"bogus\""
     --impl
     %{dep:test_basic.ml})))))

(rule
 (alias runtest)
 (action
  (diff cookie_invalid.expected cookie_invalid.actual)))

; Under "ignored", as under "disabled", every form of test_basic.ml expands
; to nothing, let%test and module%test included.

(rule
 (with-stdout-to
  cookie_ignored.actual
  (run
   ./expect_pp.exe
   -cookie
   "inline_tests=\"ignored\""
   --impl
   %{dep:test_basic.ml})))

(rule
 (alias runtest)
 (action
  (diff cookie_ignored.expected cookie_ignored.actual)))

; A dropped form is still refused for a bad name, shape or [@tags], and a
; dropped let%expect_test for a bad node, with the message of the enabled
; build; the rest of a dropped body is not checked.

(rule
 (target cookie_disabled_name.actual)
 (action
  (with-outputs-to
   cookie_disabled_name.actual
   (with-accepted-exit-codes
    1
    (run
     ./expect_pp.exe
     -cookie
     "inline_tests=\"disabled\""
     --impl
     %{dep:reject_name_pattern.ml})))))

(rule
 (alias runtest)
 (action
  (diff reject_name_pattern.expected cookie_disabled_name.actual)))

(rule
 (target cookie_disabled_shape.actual)
 (action
  (with-outputs-to
   cookie_disabled_shape.actual
   (with-accepted-exit-codes
    1
    (run
     ./expect_pp.exe
     -cookie
     "inline_tests=\"disabled\""
     --impl
     %{dep:reject_two_bindings.ml})))))

(rule
 (alias runtest)
 (action
  (diff reject_two_bindings.expected cookie_disabled_shape.actual)))

(rule
 (target cookie_disabled_tags.actual)
 (action
  (with-outputs-to
   cookie_disabled_tags.actual
   (with-accepted-exit-codes
    1
    (run
     ./expect_pp.exe
     -cookie
     "inline_tests=\"disabled\""
     --impl
     %{dep:reject_malformed_tags.ml})))))

(rule
 (alias runtest)
 (action
  (diff reject_malformed_tags.expected cookie_disabled_tags.actual)))

(rule
 (target cookie_disabled_node.actual)
 (action
  (with-outputs-to
   cookie_disabled_node.actual
   (with-accepted-exit-codes
    1
    (run
     ./expect_pp.exe
     -cookie
     "inline_tests=\"disabled\""
     --impl
     %{dep:reject_bad_payload.ml})))))

(rule
 (alias runtest)
 (action
  (diff reject_bad_payload.expected cookie_disabled_node.actual)))

(rule
 (with-stdout-to
  cookie_disabled_body.actual
  (run
   ./expect_pp.exe
   -cookie
   "inline_tests=\"disabled\""
   --impl
   %{dep:reject_dropped_body.ml})))

(rule
 (alias runtest)
 (action
  (diff cookie_disabled_body.expected cookie_disabled_body.actual)))
