; Expansion and rejection goldens for ppx_windtrap: expect_pp.exe is a
; standalone ppxlib driver and the fixtures are never compiled. Accept with
; dune promote. See doc/dev/testing.md, "Accepting a golden".

(executable
 (name expect_pp)
 (modules expect_pp)
 (libraries ppxlib ppx_windtrap))

(rule
 (with-stdout-to
  expect_basic.actual
  (run ./expect_pp.exe --impl %{dep:expect_basic.ml})))

(rule
 (alias runtest)
 (action
  (diff expect_basic.expected expect_basic.actual)))

(rule
 (with-stdout-to
  test_basic.actual
  (run ./expect_pp.exe --impl %{dep:test_basic.ml})))

(rule
 (alias runtest)
 (action
  (diff test_basic.expected test_basic.actual)))

(rule
 (target reject_uncaught_exn.actual)
 (action
  (with-outputs-to
   reject_uncaught_exn.actual
   (with-accepted-exit-codes
    1
    (run ./expect_pp.exe --impl %{dep:reject_uncaught_exn.ml})))))

(rule
 (alias runtest)
 (action
  (diff reject_uncaught_exn.expected reject_uncaught_exn.actual)))

