; Release-failure regression, inline runner (Law 8): a fixture teardown that
; raises must be REPORTED, not merely counted in the exit code. Releases run
; after the last test; the runner records each failure as a result row the
; moment it happens (one result model), and every sink projects the one
; recorded list — a runner that dropped the row would leave the whole suite
; green while still exiting 1, which this fixture pins at process level.
; runner_main.exe mirrors the inline_tests backend's generated runner;
; ../drive/drive.exe spawns it under a scrubbed environment and records
; the transcript and exit code.

(executable
 (name runner_main)
 (modules runner_main inline_release_failure)
 (libraries windtrap ppx_windtrap.runtime)
 (preprocess
  (pps ppx_windtrap)))

(rule
 (targets runner-log runner-exit)
 (deps inline_release_failure.ml)
 (action
  (run
   %{dep:../drive/drive.exe}
   --mask
   full-log
   --env
   WINDTRAP_SLOW_THRESHOLD=0
   --run
   runner
   %{dep:runner_main.exe}
   inline-test-runner
   release_failure)))

(rule
 (alias runtest)
 (action
  (diff runner-log.expected runner-log)))

(rule
 (alias runtest)
 (action
  (diff runner-exit.expected runner-exit)))
