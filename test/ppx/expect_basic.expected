let greet name = Printf.printf "hello %s\n" name
let () =
  Ppx_windtrap_runtime.Ppx_runtime.add_expect_test ~file:"./expect_basic.ml"
    ~loc:{
           Ppx_windtrap_runtime.Ppx_runtime.line = 7;
           start_bol = 255;
           start_pos = 255;
           end_pos = 523
         } ~tags:[] ~run:Expect_test_config.run
    ~sanitize:Expect_test_config.sanitize
    ~nodes:[{
              Ppx_windtrap_runtime.Ppx_runtime.id = 0;
              kind = Ppx_windtrap_runtime.Ppx_runtime.Expect;
              loc =
                {
                  Ppx_windtrap_runtime.Ppx_runtime.line = 9;
                  start_bol = 302;
                  start_pos = 304;
                  end_pos = 337
                };
              payload =
                (Some
                   {
                     Ppx_windtrap_runtime.Ppx_runtime.contents =
                       "\n    hello world\n  ";
                     delimiter = (Ppx_windtrap_runtime.Ppx_runtime.Tag "");
                     loc =
                       {
                         Ppx_windtrap_runtime.Ppx_runtime.line = 9;
                         start_bol = 302;
                         start_pos = 313;
                         end_pos = 336
                       }
                   })
            };
           {
             Ppx_windtrap_runtime.Ppx_runtime.id = 1;
             kind = Ppx_windtrap_runtime.Ppx_runtime.Expect_exact;
             loc =
               {
                 Ppx_windtrap_runtime.Ppx_runtime.line = 15;
                 start_bol = 451;
                 start_pos = 453;
                 end_pos = 491
               };
             payload =
               (Some
                  {
                    Ppx_windtrap_runtime.Ppx_runtime.contents =
                      "captured 12 bytes\n";
                    delimiter = (Ppx_windtrap_runtime.Ppx_runtime.Tag "");
                    loc =
                      {
                        Ppx_windtrap_runtime.Ppx_runtime.line = 15;
                        start_bol = 451;
                        start_pos = 468;
                        end_pos = 490
                      }
                  })
           };
           {
             Ppx_windtrap_runtime.Ppx_runtime.id = 2;
             kind = Ppx_windtrap_runtime.Ppx_runtime.Expect;
             loc =
               {
                 Ppx_windtrap_runtime.Ppx_runtime.line = 18;
                 start_bol = 512;
                 start_pos = 514;
                 end_pos = 523
               };
             payload = None
           }]
    ~body_loc:{
                Ppx_windtrap_runtime.Ppx_runtime.line = 7;
                start_bol = 255;
                start_pos = 255;
                end_pos = 523
              }
    ~trailing_loc:{
                    Ppx_windtrap_runtime.Ppx_runtime.line = 18;
                    start_bol = 512;
                    start_pos = 523;
                    end_pos = 523
                  } "greetings"
    (fun () ->
       greet "world";
       Ppx_windtrap_runtime.Ppx_runtime.expect ~id:0;
       greet "again";
       (let noise = Ppx_windtrap_runtime.Ppx_runtime.expect_output () in
        Printf.printf "captured %d bytes\n" (String.length noise);
        Ppx_windtrap_runtime.Ppx_runtime.expect ~id:1;
        print_string "";
        Ppx_windtrap_runtime.Ppx_runtime.expect ~id:2))
