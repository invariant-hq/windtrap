; Expansion goldens of the coverage rewriter over a file the mutation
; rewriter ran on first, which is the order of the driver that dune builds
; for a stanza naming both backends (the libraries below are linked in that
; driver's order). A new fixture is one X.ml and one X.expected, then dune
; build @gen-rules --auto-promote.

(executable
 (name after_mutate_pp)
 (modules after_mutate_pp)
 (libraries ppxlib windtrap_coverage_ppx windtrap_mutate_ppx))

(include dune.inc)

(rule
 (deps
  (glob_files *.ml))
 (action
  (with-stdout-to
   dune.inc.gen
   (run ../../gen/gen_dune.exe rules after_mutate_pp.exe %{deps}))))

(rule
 (alias gen-rules)
 (action
  (diff dune.inc dune.inc.gen)))

(alias
 (name runtest)
 (deps
  (alias gen-rules)))
