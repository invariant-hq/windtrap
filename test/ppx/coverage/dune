(rule
 (target reject_bad_payload.actual)
 (action
  (with-outputs-to
   reject_bad_payload.actual
   (with-accepted-exit-codes
    1
    (run ./coverage_pp.exe --impl %{dep:reject_bad_payload.ml})))))

(rule
 (alias runtest)
 (action
  (diff reject_bad_payload.expected reject_bad_payload.actual)))

(rule
 (target reject_misplaced_on.actual)
 (action
  (with-outputs-to
   reject_misplaced_on.actual
   (with-accepted-exit-codes
    1
    (run ./coverage_pp.exe --impl %{dep:reject_misplaced_on.ml})))))

(rule
 (alias runtest)
 (action
  (diff reject_misplaced_on.expected reject_misplaced_on.actual)))

(rule
 (target reject_off_reason.actual)
 (action
  (with-outputs-to
   reject_off_reason.actual
   (with-accepted-exit-codes
    1
    (run ./coverage_pp.exe --impl %{dep:reject_off_reason.ml})))))

(rule
 (alias runtest)
 (action
  (diff reject_off_reason.expected reject_off_reason.actual)))

; Attribute-grammar parity: the acceptance and shared rejection fixtures
; must equal their mutate twins modulo the namespace token, and
; reject_off_reason above pins the one intended difference.

(rule
 (alias runtest)
 (action
  (ignore-outputs
   (run ./coverage_pp.exe --impl %{dep:parity_spellings.ml}))))

(rule
 (target parity_spellings.here.normalized)
 (action
  (with-stdout-to
   %{target}
   (run sed "s/coverage/NS/g" %{dep:parity_spellings.ml}))))

(rule
 (target parity_spellings.twin.normalized)
 (action
  (with-stdout-to
   %{target}
   (run sed "s/mutate/NS/g" %{dep:../mutate/parity_spellings.ml}))))

(rule
 (alias runtest)
 (action
  (run
   diff
   -u
   %{dep:parity_spellings.here.normalized}
   %{dep:parity_spellings.twin.normalized})))

(rule
 (target reject_bad_payload.here.normalized)
 (action
  (with-stdout-to
   %{target}
   (run sed "s/coverage/NS/g" %{dep:reject_bad_payload.ml}))))

(rule
 (target reject_bad_payload.twin.normalized)
