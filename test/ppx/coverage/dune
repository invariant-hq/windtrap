; Expansion and rejection goldens for the coverage instrumenter:
; coverage_pp.exe is a standalone ppxlib driver, the fixtures are never
; compiled, and the goldens pin point indexes and byte extents, so read
; every promoted diff. See doc/dev/testing.md, "Accepting a golden".

(executable
 (name coverage_pp)
 (modules coverage_pp)
 (libraries ppxlib windtrap_coverage_ppx))

; dune.inc holds one golden rule pair per fixture, written by
; ../gen/gen_dune.exe from the list of .ml files here: a new fixture is one
; X.ml and one X.expected, then dune build @gen-rules --auto-promote. A
; reject_* fixture must exit 1, and its whole output is its golden. Each
; reject_* fixture with a twin of the same name in ../mutate is also
; diffed against the twin's output modulo the attribute namespace, so a
; message changed on one side only is caught; reject_off_reason has no
; twin, and is the one intended difference.

(include dune.inc)

(rule
 (deps
  (glob_files *.ml)
  (glob_files ../mutate/reject_*.ml))
 (action
  (with-stdout-to
   dune.inc.gen
   (run ../gen/gen_dune.exe rules coverage_pp.exe %{deps}))))

(rule
 (alias gen-rules)
 (action
  (diff dune.inc dune.inc.gen)))

(alias
 (name runtest)
 (deps
  (alias gen-rules)))

; The legal spellings of the exclusion grammar are accepted. The mutation
; suite runs its driver over this file with the namespace swapped, so the
; two drivers read one list of spellings.

(rule
 (alias runtest)
 (action
  (ignore-outputs
   (run ./coverage_pp.exe --impl %{dep:parity_spellings.ml}))))

; Under the input names //toplevel// and (stdin), and a base name .ocamlinit
; or topfind, the rewriter returns fixture_input_name.ml as parsed; under its
; own name, the fixture's golden shows it instrumented.

(rule
 (with-stdout-to
  input_name_toplevel.actual
  (run
   ./coverage_pp.exe
   -loc-filename
   //toplevel//
   --impl
   %{dep:fixture_input_name.ml})))

(rule
 (alias runtest)
 (action
  (diff input_name_ignored.expected input_name_toplevel.actual)))

(rule
 (with-stdout-to
  input_name_stdin.actual
  (run
   ./coverage_pp.exe
   -loc-filename
   "(stdin)"
   --impl
   %{dep:fixture_input_name.ml})))

(rule
 (alias runtest)
 (action
  (diff input_name_ignored.expected input_name_stdin.actual)))

(rule
 (with-stdout-to
  input_name_ocamlinit.actual
  (run
   ./coverage_pp.exe
   -loc-filename
   lib/.ocamlinit
   --impl
   %{dep:fixture_input_name.ml})))

(rule
 (alias runtest)
 (action
  (diff input_name_ignored.expected input_name_ocamlinit.actual)))

(rule
 (with-stdout-to
  input_name_topfind.actual
  (run
   ./coverage_pp.exe
   -loc-filename
   lib/topfind
   --impl
   %{dep:fixture_input_name.ml})))

(rule
 (alias runtest)
 (action
  (diff input_name_ignored.expected input_name_topfind.actual)))
