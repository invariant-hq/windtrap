; Coverage never changes what a program means: covsem_fixtures is
; instrumented unconditionally and compared with the uninstrumented answer.
; WINDTRAP_COVERAGE_FILE keeps the at_exit dump out of _build/_coverage.
; See doc/dev/testing.md, "The five families".

(library
 (name covsem_fixtures)
 (modules covsem_fixtures)
 (preprocess
  (pps ppx_windtrap.coverage)))

(test
 (name test_coverage_semantics)
 (modules test_coverage_semantics)
 (libraries covsem_fixtures windtrap windtrap_runtime)
 (action
  (setenv
   WINDTRAP_COVERAGE_FILE
   test_coverage_semantics.coverage
   (run %{test}))))

; Links the fixtures alone: the rewriter's ppx_runtime_libraries inject the
; runtime, and nothing pulls the core in.

(test
 (name test_coverage_linkonly)
 (modules test_coverage_linkonly)
 (libraries covsem_fixtures)
 (action
  (setenv
   WINDTRAP_COVERAGE_FILE
   test_coverage_linkonly.coverage
   (run %{test}))))
