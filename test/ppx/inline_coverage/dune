; The inline (ppx) runner's coverage is live — the summary line follows
; the library runner's rules, since the inline runner is that runner,
; and WINDTRAP_COVERAGE switches it there too. covlib is
; instrumented unconditionally (pps, no --instrument-with needed) and its
; [false] branch is never exercised, so the line has something to report;
; runner_main mirrors the inline_tests backend's generated runner (the
; conformance corpus pattern). ../drive/drive.exe spawns it twice under a
; scrubbed environment — default, then WINDTRAP_COVERAGE=off — with
; WINDTRAP_COVERAGE_FILE pointed at a fresh scratch dump per run (nothing
; lands in the real _build/_coverage). Durations are masked; the committed
; goldens pin both transcripts byte-for-byte.

(library
 (name covlib)
 (modules covlib)
 (preprocess
  (pps ppx_windtrap.coverage)))

(executable
 (name runner_main)
 (modules runner_main inline_cov)
 (libraries windtrap ppx_windtrap.runtime covlib)
 (preprocess
  (pps ppx_windtrap)))

(rule
 (targets run-summary-log run-summary-exit run-off-log run-off-exit)
 (deps covlib.ml)
 (action
  (run
   %{dep:../drive/drive.exe}
   --mkdir
   summary-dump
   --mkdir
   off-dump
   --env
   WINDTRAP_COVERAGE_ONLY=test/ppx/inline_coverage/covlib.ml
   --run
   run-summary
   %{dep:runner_main.exe}
   --env
   WINDTRAP_COVERAGE_FILE=summary-dump/self.coverage
   inline-test-runner
   inline_cov
   --run
   run-off
   %{dep:runner_main.exe}
   --env
   WINDTRAP_COVERAGE=off
   --env
   WINDTRAP_COVERAGE_FILE=off-dump/self.coverage
   inline-test-runner
   inline_cov)))

(rule
 (alias runtest)
 (action
  (diff summary-log.expected run-summary-log)))

(rule
 (alias runtest)
 (action
  (diff summary-exit.expected run-summary-exit)))

(rule
 (alias runtest)
 (action
  (diff off-log.expected run-off-log)))

(rule
 (alias runtest)
 (action
  (diff off-exit.expected run-off-exit)))
