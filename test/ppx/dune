; Golden expansion tests for the ppx_windtrap rewriter. pp.exe is a
; standalone ppxlib driver linking the rewriter; each fixture .ml is
; expanded (with-stdout-to) or rejected (with-accepted-exit-codes 1,
; capturing the diagnostic) and the result diffed against a committed
; .expected golden. Accept intended changes with dune promote — read
; the diff first. The fixtures are not compiled: only pp is a module.

(executable
 (name pp)
 (modules pp)
 (libraries ppxlib ppx_windtrap))

; ── Expansion goldens ──

(rule
 (with-stdout-to
  expect_basic.actual
  (run ./pp.exe --impl %{dep:expect_basic.ml})))

(rule
 (alias runtest)
 (action
  (diff expect_basic.expected expect_basic.actual)))

(rule
 (with-stdout-to
  test_basic.actual
  (run ./pp.exe --impl %{dep:test_basic.ml})))

(rule
 (alias runtest)
 (action
  (diff test_basic.expected test_basic.actual)))

; ── Rejection diagnostics (mechanism (a) and misplacement errors) ──

(rule
 (target reject_uncaught_exn.actual)
 (action
  (with-outputs-to
   reject_uncaught_exn.actual
   (with-accepted-exit-codes
    1
    (run ./pp.exe --impl %{dep:reject_uncaught_exn.ml})))))

(rule
 (alias runtest)
 (action
  (diff reject_uncaught_exn.expected reject_uncaught_exn.actual)))

(rule
