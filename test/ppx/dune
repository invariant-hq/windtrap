; ── Cookie drop modes (Jane Street protocol) ──

(rule
 (with-stdout-to
  cookie_drop.actual
  (run ./pp.exe -cookie "inline-test=drop" --impl %{dep:test_basic.ml})))

(rule
 (alias runtest)
 (action
  (diff cookie_drop.expected cookie_drop.actual)))

(rule
 (with-stdout-to
  cookie_disabled.actual
  (run
   ./pp.exe
   -cookie
   "inline_tests=\"disabled\""
   --impl
   %{dep:expect_basic.ml})))

(rule
 (alias runtest)
 (action
  (diff cookie_disabled.expected cookie_disabled.actual)))

(rule
 (with-stdout-to
  cookie_enabled.actual
  (run
   ./pp.exe
   -cookie
   "inline_tests=\"enabled\""
   --impl
   %{dep:test_basic.ml})))

(rule
 (alias runtest)
 (action
  (diff test_basic.expected cookie_enabled.actual)))

(rule
 (target cookie_invalid.actual)
 (action
  (with-outputs-to
   cookie_invalid.actual
   (with-accepted-exit-codes
    1
    (run ./pp.exe -cookie "inline-test=bogus" --impl %{dep:test_basic.ml})))))

(rule
 (alias runtest)
 (action
  (diff cookie_invalid.expected cookie_invalid.actual)))
