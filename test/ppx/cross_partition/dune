; The cross-partition promotion contract. Under dune's inline_tests
; protocol every partition of a library runs inside ONE action, and the
; per-file (diff? source source.corrected) steps run only after every
; partition exits 0 (dune_rules/inline_tests.ml: progn [concurrent runs;
; concurrent diffs]). So a partition's exit code decides whether the
; whole LIBRARY's corrections register, siblings included, and no
; partition can see enough to say so. This directory pins the facts dune
; turns into that outcome: the crashing partition exits 1 and writes
; nothing; the stale partition exits 0 and writes its correction.
;
; runner_main.exe mirrors the backend's generated runner;
; drive_cross_partition.exe spawns it once per partition — through the
; shared ../drive harness, with its own sequence — and records the
; transcripts, the exit codes, and what each run wrote. Both runs live
; in one rule: two rules in one dune directory share a build directory
; and may run concurrently, so each would see the other's .corrected
; files.

(executable
 (name runner_main)
 (modules runner_main crash stale)
 (libraries ppx_windtrap.runtime)
 (preprocess
  (pps ppx_windtrap)))

(executable
 (name drive_cross_partition)
 (modules drive_cross_partition)
 (libraries drive_harness unix))

(rule
 (targets
  crash-log
  crash-exit
  crash-corrected
  stale-log
  stale-exit
  stale.ml.corrected)
 (deps crash.ml stale.ml)
 (action
  (run ./drive_cross_partition.exe %{dep:runner_main.exe})))

; The plain runs: the bug's two halves, as dune reads them.

(rule
 (alias runtest)
 (action
  (diff crash-exit.expected crash-exit)))

(rule
 (alias runtest)
 (action
  (diff crash-corrected.expected crash-corrected)))

(rule
 (alias runtest)
 (action
  (diff crash-log.expected crash-log)))

(rule
 (alias runtest)
 (action
  (diff stale-exit.expected stale-exit)))

(rule
 (alias runtest)
 (action
  (diff stale-log.expected stale-log)))

(rule
 (alias runtest)
 (action
  (diff stale.ml.corrected.expected stale.ml.corrected)))
