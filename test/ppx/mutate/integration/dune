; Does an instrumented build compile and register? One library per
; question. See doc/dev/testing.md, "The five families".

; Every warning fatal but 70: shadowed redefines every unqualified name a
; guard could reach, oracle is the population test_registration arms one
; mutant at a time.

(library
 (name windtrap_mutate_forced)
 (modules forced no_guard oracle shadowed)
 (flags
  (:standard -w +a-70 -warn-error +a))
 (preprocess
  (pps ppx_windtrap.mutate)))

; Type-directed disambiguation is warning 40's subject, so this one keeps
; dune's default warning set.

(library
 (name windtrap_mutate_disambiguate)
 (modules disambiguate expected_type)
 (preprocess
  (pps ppx_windtrap.mutate)))

; Compiled under both backends at once. test_registration lists it, calling
; nothing in it, so that runtest builds it at all.

(library
 (name windtrap_mutate_both)
 (modules both)
 (instrumentation
  (backend ppx_windtrap.coverage))
 (instrumentation
  (backend ppx_windtrap.mutate)))

(test
 (name test_registration)
 (modules test_registration)
 (libraries
  windtrap.runtime
  windtrap_mutate_forced
  windtrap_mutate_disambiguate
  windtrap_mutate_both))
