; A new fixture is one X.ml and one X.expected, then dune build @gen-rules
; --auto-promote.

(executable
 (name generated_pp)
 (modules generated_pp)
 (libraries ppxlib windtrap_test_ppx_generated windtrap_mutate_ppx))

(include dune.inc)

(rule
 (deps
  (glob_files *.ml))
 (action
  (with-stdout-to
   dune.inc.gen
   (run ../../gen/gen_dune.exe rules generated_pp.exe %{deps}))))

(rule
 (alias gen-rules)
 (action
  (diff dune.inc dune.inc.gen)))

(alias
 (name runtest)
 (deps
  (alias gen-rules)))
