; Expansion goldens of the mutation rewriter over a file the coverage
; rewriter ran on first, which is the order of a driver that links the
; mutation rewriter before the coverage one, as below. A new fixture is one
; X.ml and one X.expected, then dune build @gen-rules --auto-promote.

(executable
 (name after_coverage_pp)
 (modules after_coverage_pp)
 (libraries ppxlib windtrap_mutate_ppx windtrap_coverage_ppx))

(include dune.inc)

(rule
 (deps
  (glob_files *.ml))
 (action
  (with-stdout-to
   dune.inc.gen
   (run ../../gen/gen_dune.exe rules after_coverage_pp.exe %{deps}))))

(rule
 (alias gen-rules)
 (action
  (diff dune.inc dune.inc.gen)))

(alias
 (name runtest)
 (deps
  (alias gen-rules)))
