(executable
 (name mutate_pp)
 (modules mutate_pp)
 (libraries ppxlib windtrap_mutate_ppx))

; A new fixture is one X.ml and one X.expected, then dune build @gen-rules
; --auto-promote. A reject_* fixture must exit 1, and its whole output is its
; golden.

(include dune.inc)

(rule
 (deps
  (glob_files *.ml))
 (action
  (with-stdout-to
   dune.inc.gen
   (run ../gen/gen_dune.exe rules mutate_pp.exe %{deps}))))

(rule
 (alias gen-rules)
 (action
  (diff dune.inc dune.inc.gen)))

(alias
 (name runtest)
 (deps
  (alias gen-rules)))

(rule
 (with-stdout-to
  parity_spellings.txt
  (run sed "s/coverage/mutate/g" %{dep:../coverage/parity_spellings.ml})))

(rule
 (alias runtest)
 (action
  (ignore-outputs
   (run ./mutate_pp.exe --impl %{dep:parity_spellings.txt}))))

(rule
 (with-stdout-to
  input_name_toplevel.actual
  (run
   ./mutate_pp.exe
   -loc-filename
   //toplevel//
   --impl
   %{dep:fixture_input_name.ml})))

(rule
 (alias runtest)
 (action
  (diff input_name_ignored.expected input_name_toplevel.actual)))

(rule
 (with-stdout-to
  input_name_stdin.actual
  (run
   ./mutate_pp.exe
   -loc-filename
   "(stdin)"
   --impl
   %{dep:fixture_input_name.ml})))

(rule
 (alias runtest)
 (action
  (diff input_name_ignored.expected input_name_stdin.actual)))

(rule
 (with-stdout-to
  input_name_ocamlinit.actual
  (run
   ./mutate_pp.exe
   -loc-filename
   lib/.ocamlinit
   --impl
   %{dep:fixture_input_name.ml})))

(rule
 (alias runtest)
 (action
  (diff input_name_ignored.expected input_name_ocamlinit.actual)))

(rule
 (with-stdout-to
  input_name_topfind.actual
  (run
   ./mutate_pp.exe
   -loc-filename
   lib/topfind
   --impl
   %{dep:fixture_input_name.ml})))

(rule
 (alias runtest)
 (action
  (diff input_name_ignored.expected input_name_topfind.actual)))
