; Expansion and rejection goldens for the mutation instrumenter:
; mutate_pp.exe is a standalone ppxlib driver, the fixtures are never
; compiled (integration/ compiles generated code for real), and the parity
; rules against the coverage twin live in ../coverage/dune. See
; doc/dev/testing.md, "Accepting a golden".

(executable
 (name mutate_pp)
 (modules mutate_pp)
 (libraries ppxlib windtrap_mutate_ppx))

; dune.inc holds one golden rule pair per fixture, written by
; ../gen/gen_dune.exe from the list of .ml files here: a new fixture is one
; X.ml and one X.expected, then dune build @gen-rules --auto-promote. A
; reject_* fixture must exit 1, and its whole output is its golden.

(include dune.inc)

(rule
 (deps
  (glob_files *.ml))
 (action
  (with-stdout-to
   dune.inc.gen
   (run ../gen/gen_dune.exe rules mutate_pp.exe %{deps}))))

(rule
 (alias gen-rules)
 (action
  (diff dune.inc dune.inc.gen)))

(alias
 (name runtest)
 (deps
  (alias gen-rules)))

; The legal spellings of the exclusion grammar are accepted: the coverage
; suite's parity_spellings.ml with the namespace swapped, so the two
; drivers read one list of spellings.

(rule
 (with-stdout-to
  parity_spellings.txt
  (run sed "s/coverage/mutate/g" %{dep:../coverage/parity_spellings.ml})))

(rule
 (alias runtest)
 (action
  (ignore-outputs
   (run ./mutate_pp.exe --impl %{dep:parity_spellings.txt}))))

; Under the input names //toplevel// and (stdin), and a base name .ocamlinit
; or topfind, the rewriter returns fixture_input_name.ml as parsed; under its
; own name, the fixture's golden shows it mutated.

(rule
 (with-stdout-to
  input_name_toplevel.actual
  (run
   ./mutate_pp.exe
   -loc-filename
   //toplevel//
   --impl
   %{dep:fixture_input_name.ml})))

(rule
 (alias runtest)
 (action
  (diff input_name_ignored.expected input_name_toplevel.actual)))

(rule
 (with-stdout-to
  input_name_stdin.actual
  (run
   ./mutate_pp.exe
   -loc-filename
   "(stdin)"
   --impl
   %{dep:fixture_input_name.ml})))

(rule
 (alias runtest)
 (action
  (diff input_name_ignored.expected input_name_stdin.actual)))

(rule
 (with-stdout-to
  input_name_ocamlinit.actual
  (run
   ./mutate_pp.exe
   -loc-filename
   lib/.ocamlinit
   --impl
   %{dep:fixture_input_name.ml})))

(rule
 (alias runtest)
 (action
  (diff input_name_ignored.expected input_name_ocamlinit.actual)))

(rule
 (with-stdout-to
  input_name_topfind.actual
  (run
   ./mutate_pp.exe
   -loc-filename
   lib/topfind
   --impl
   %{dep:fixture_input_name.ml})))

(rule
 (alias runtest)
 (action
  (diff input_name_ignored.expected input_name_topfind.actual)))
