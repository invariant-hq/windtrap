[@@@ocaml.text "/*"]
module Windtrap_mut_________fixture_all_dismissed___ml =
  struct
    type site = Windtrap_runtime.Mutate.site =
      {
      line: int ;
      col: int ;
      rewrite: string ;
      before: string ;
      after: string ;
      dismissed: string option }
    let ___windtrap_armed___ =
      Windtrap_runtime.Mutate.register ~file:"./fixture_all_dismissed.ml"
        ~sites:[|{
                   line = 8;
                   col = 5;
                   rewrite = "ge";
                   before = "want > 16";
                   after = "want >= 16";
                   dismissed = (Some "both arms yield 16 at the boundary")
                 }|]
  end
[@@@ocaml.text "/*"]
let cap want =
  if ((want > 16)[@mutate off "both arms yield 16 at the boundary"])
  then want
  else 16
