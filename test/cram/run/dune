(executable
 (name suite_main)
 (modules suite_main)
 (libraries windtrap unix))

(cram
 (applies_to :whole_subtree)
 (deps suite_main.exe))

; baselines.t accepts literals in a copy of the suite's source.

(cram
 (applies_to baselines)
 (deps suite_main.ml))

(executable
 (name send_signal)
 (modules send_signal)
 (libraries unix))

(cram
 (applies_to signals)
 (enabled_if
  (<> %{os_type} Win32))
 (deps send_signal.exe))

; broadcast.t runs the mutation loop, which forks, over a suite whose one
; module is instrumented in every build.

(library
 (name mutant_subject)
 (modules mutant_subject)
 (preprocess
  (pps ppx_windtrap.mutate)))

(executable
 (name mutant_main)
 (modules mutant_main)
 (libraries windtrap mutant_subject))

(cram
 (applies_to broadcast)
 (enabled_if
  (<> %{os_type} Win32))
 (deps mutant_main.exe))

; nodune.t reads OCAMLPATH as POSIX spells it and runs the mutation loop.
; Under --instrument-with ppx_windtrap.coverage, dune 3.24 closes
; (package windtrap) over ppx_windtrap, whose runtime depends on windtrap,
; and reports a dependency cycle; a dune built from main does not. CI's
; coverage job, on dune 3.24, sets SKIP_PACKAGE_SESSIONS for that reason,
; and every session that depends on a package is left out under it.

(cram
 (applies_to nodune)
 (enabled_if
  (and
   (<> %{os_type} Win32)
   (<> %{env:SKIP_PACKAGE_SESSIONS=} true)))
 (deps
  (package windtrap)
  ../ppx/pp.exe))
