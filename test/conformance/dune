; The vendored ppx_expect corpus stays byte-identical to upstream, so
; formatting is disabled for the subtree.

(env
 (_
  (formatting disabled)))

(executable
 (name pp)
 (modules pp)
 (libraries ppxlib ppx_windtrap))

(executable
 (name count)
 (modules count))

(rule
 (deps
  (sandbox always)
  (source_tree corpus))
 (action
  (with-stdout-to
   counts
   (run ./count.exe corpus))))

(rule
 (alias runtest)
 (action
  (diff counts.expected counts)))
