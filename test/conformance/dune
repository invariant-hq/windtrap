; The vendored ppx_expect corpus stays byte-identical to upstream, so
; formatting is disabled for the subtree. The runners are driven by
; test/cli/inline_runner/drive/drive.exe, the one driver of runner
; transcripts; pp.exe expands the rejected set. See doc/dev/testing.md,
; "The conformance corpus".

(env
 (_
  (formatting disabled)))

(executable
 (name pp)
 (modules pp)
 (libraries ppxlib ppx_windtrap))

; The corpus's numbers, computed from its files: RESULTS.md quotes
; counts.expected and restates none of them.

(executable
 (name count)
 (modules count))

(rule
 (deps
  (sandbox always)
  (source_tree corpus))
 (action
  (with-stdout-to
   counts
   (run ./count.exe corpus))))

(rule
 (alias runtest)
 (action
  (diff counts.expected counts)))
