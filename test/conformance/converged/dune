 (copy ../corpus/explicit-strict-false/negative-test/nine.ml.corrected.expected nine.ml))

(rule
 (copy ../corpus/negative-tests/corpus_shim.ml corpus_shim.ml))

(executable
 (name converged_runner)
 (modules
  converged_runner
  corpus_shim
  exact
  flexible
  missing
  normal_strings
  semicolon
  spacing
  string_extension_syntax
  string_padding
  trailing
  unidiomatic_syntax
  similar_distinct_outputs
  foo
  nine)
 (libraries ppx_windtrap.runtime)
 (preprocess
  (pps ppx_windtrap)))

(rule
 (targets converged-log converged-exit)
 (deps
  exact.ml
  flexible.ml
  missing.ml
  normal_strings.ml
  semicolon.ml
  spacing.ml
  string_extension_syntax.ml
  string_padding.ml
  trailing.ml
  unidiomatic_syntax.ml
  similar_distinct_outputs.ml
  foo.ml
  nine.ml)
 (action
  (run
   %{dep:../../support/drive/drive.exe}
   --mask
   full-log
   --env
   WINDTRAP_SLOW_THRESHOLD=0
   --run
   converged
   %{dep:converged_runner.exe}
   inline-test-runner
   conformance)))

(rule
 (package ppx_windtrap)
 (alias runtest)
 (action
  (diff converged-exit.expected converged-exit)))

(rule
 (package ppx_windtrap)
 (alias runtest)
 (action
  (diff converged-log.expected converged-log)))

; chdir.ml runs in a process of its own, as in the corpus, and on POSIX
; only, for the reason ../corpus/negative-tests/dune gives.

(rule
 (copy ../corpus/negative-tests/chdir.ml.corrected.expected chdir.ml))

(executable
 (name chdir_runner)
 (modules chdir_runner chdir)
 (libraries ppx_windtrap.runtime)
 (preprocess
  (pps ppx_windtrap)))

(rule
 (targets chdir-log chdir-exit)
 (enabled_if
  (<> %{os_type} Win32))
 (deps chdir.ml)
 (action
  (run
   %{dep:../../support/drive/drive.exe}
   --mask
   full-log
   --env
   WINDTRAP_SLOW_THRESHOLD=0
   --run
   chdir
   %{dep:chdir_runner.exe}
   inline-test-runner
   conformance)))

(rule
 (package ppx_windtrap)
 (alias runtest)
 (enabled_if
  (<> %{os_type} Win32))
 (action
  (diff chdir-exit.expected chdir-exit)))

(rule
 (package ppx_windtrap)
 (alias runtest)
 (enabled_if
  (<> %{os_type} Win32))
 (action
  (diff chdir-log.expected chdir-log)))

; escaped_strings.ml runs in a process of its own, on OCaml 5.2 and later,
; which read a CR LF line end inside a literal as LF. Its corrections of
; [%expect_exact] over "a\r\nb" are quoted literals, so the corrected
; source passes.

(rule
 (copy
  ../corpus/negative-tests/escaped_strings.ml.corrected.expected
  escaped_strings.ml))

(executable
 (name escaped_strings_runner)
 (modules escaped_strings_runner escaped_strings)
 (libraries ppx_windtrap.runtime)
 (preprocess
  (pps ppx_windtrap)))

(rule
 (targets escaped_strings-log escaped_strings-exit)
 (enabled_if
  (>= %{ocaml_version} 5.2))
 (deps escaped_strings.ml)
 (action
  (run
   %{dep:../../support/drive/drive.exe}
   --mask
   full-log
   --env
   WINDTRAP_SLOW_THRESHOLD=0
   --run
   escaped_strings
   %{dep:escaped_strings_runner.exe}
   inline-test-runner
   conformance)))

(rule
 (package ppx_windtrap)
 (alias runtest)
 (enabled_if
  (>= %{ocaml_version} 5.2))
 (action
  (diff escaped_strings-exit.expected escaped_strings-exit)))

(rule
 (package ppx_windtrap)
 (alias runtest)
 (enabled_if
  (>= %{ocaml_version} 5.2))
 (action
  (diff escaped_strings-log.expected escaped_strings-log)))
