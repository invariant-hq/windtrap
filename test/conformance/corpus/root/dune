; Upstream test/*.ml — honored pass set: a real (inline_tests) library
; preprocessed with ppx_windtrap, driven by dune's generated runner
; under @runtest, exactly the swap the RFC promises adopting suites.
; Every fixture must pass; any mismatch fails runtest with a
; promotable diff.

(library
 (name conformance_root)
 (modules
  escaped_strings
  string_extension_syntax
  test_output
  test_stderr
  unidiomatic_syntax)
 (inline_tests)
 (preprocess
  (pps ppx_windtrap)))

; Rejected set: expansion must exit 1 with the explicit
; "not supported by ppx_windtrap" diagnostic, goldened per file.

(rule
 (target test_expectation.rejected)
 (action
  (with-outputs-to
   test_expectation.rejected
   (with-accepted-exit-codes
    1
    (run ../../pp.exe --impl %{dep:test_expectation.ml})))))

(rule
 (alias runtest)
 (action
  (diff test_expectation.rejected.expected test_expectation.rejected)))

