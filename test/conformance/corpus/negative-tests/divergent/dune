; similar_distinct_outputs.ml: a functor instantiated twice registers
; two tests with identical names/locations; windtrap renames the later
; duplicate and runs both, and the node they share, reached with two
; outputs that normalize alike, is corrected once, byte-identical to the
; upstream golden. Kept in its own runner so its exit code and transcript
; are its own.

(executable
 (name conformance_runner)
 (modules conformance_runner similar_distinct_outputs)
 (libraries ppx_windtrap.runtime)
 (preprocess
  (pps ppx_windtrap)))

(rule
 (targets runner-log runner-exit similar_distinct_outputs.ml.corrected)
 (deps similar_distinct_outputs.ml)
 (action
  (run
   %{dep:../../../../cli/inline_runner/drive/drive.exe}
   --mask
   full-log
   --env
   WINDTRAP_SLOW_THRESHOLD=0
   --placeholder
   similar_distinct_outputs.ml
   --run
   runner
   %{dep:conformance_runner.exe}
   inline-test-runner
   conformance)))

(rule
 (alias runtest)
 (action
  (diff runner-exit.expected runner-exit)))

(rule
 (alias runtest)
 (action
  (diff runner-log.expected runner-log)))

(rule
 (alias runtest)
 (action
  (diff
   similar_distinct_outputs.ml.corrected.expected
   similar_distinct_outputs.ml.corrected)))
