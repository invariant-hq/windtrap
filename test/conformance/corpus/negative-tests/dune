; Corrections harness for upstream test/negative-tests: every fixture
; is an intentionally failing expect test, and the observable is the
; .corrected file the runner writes, compared byte-for-byte against the
; golden <f>.ml.corrected.expected. The goldens are windtrap's own
; recorded output, not upstream's (counts.expected says how many are
; equal). runner-exit pins the promotion-protocol exit code: 0, since
; every failure in this set is an expect mismatch with a recorded
; correction; runner-log pins the transcript, which also shows
; export_test.ml and import_test.ml passing. The uncaught-exn,
; expectation and unreachable fixtures (comment, exn*, expectation,
; function_with_distinct_outputs, functor, tag, zero_alloc) are the
; rejected set, asserted by the pp.exe rules at the bottom. Three
; upstream fixtures are not vendored (nine.ml and three.ml want
; reformat-on-match, unusual_payload_location.ml's golden contradicts
; its own pinned source): see ../../RESULTS.md. similar_distinct_outputs
; lives in divergent/.

(executable
 (name conformance_runner)
 (modules
  conformance_runner
  corpus_shim
  exact
  export_test
  flexible
  import_test
  missing
  normal_strings
  semicolon
  spacing
  string_extension_syntax
  string_padding
  trailing
  unidiomatic_syntax)
 (libraries ppx_windtrap.runtime)
 (preprocess
  (pps ppx_windtrap)))

(rule
 (targets
  runner-log
  runner-exit
  exact.ml.corrected
  flexible.ml.corrected
  missing.ml.corrected
  normal_strings.ml.corrected
  semicolon.ml.corrected
  spacing.ml.corrected
  string_extension_syntax.ml.corrected
  string_padding.ml.corrected
  trailing.ml.corrected
  unidiomatic_syntax.ml.corrected)
 (deps
  exact.ml
  export_test.ml
  flexible.ml
  import_test.ml
  missing.ml
  normal_strings.ml
  semicolon.ml
  spacing.ml
  string_extension_syntax.ml
  string_padding.ml
  trailing.ml
  unidiomatic_syntax.ml)
 (action
  (run
   %{dep:../../../support/drive/drive.exe}
   --mask
   full-log
   --env
   WINDTRAP_SLOW_THRESHOLD=0
   --placeholder
   exact.ml
   --placeholder
   flexible.ml
   --placeholder
   missing.ml
   --placeholder
   normal_strings.ml
   --placeholder
   semicolon.ml
   --placeholder
   spacing.ml
   --placeholder
   string_extension_syntax.ml
   --placeholder
   string_padding.ml
   --placeholder
   trailing.ml
   --placeholder
   unidiomatic_syntax.ml
   --run
   runner
   %{dep:conformance_runner.exe}
   inline-test-runner
   conformance)))

(rule
 (alias runtest)
 (action
  (diff runner-exit.expected runner-exit)))

(rule
 (alias runtest)
 (action
  (diff runner-log.expected runner-log)))

; escaped_strings.ml runs in a process of its own because its golden is
; the compiler's reading of a CR LF inside a quoted literal, LF since OCaml
; 5.2, so its rules hold from 5.2 on (see ../../converged/dune).

(executable
 (name escaped_strings_runner)
 (modules escaped_strings_runner escaped_strings)
 (libraries ppx_windtrap.runtime)
 (preprocess
  (pps ppx_windtrap)))

(rule
 (targets
  escaped_strings-log
  escaped_strings-exit
  escaped_strings.ml.corrected)
 (enabled_if
  (>= %{ocaml_version} 5.2))
 (deps escaped_strings.ml)
 (action
  (run
   %{dep:../../../support/drive/drive.exe}
   --mask
   full-log
   --env
   WINDTRAP_SLOW_THRESHOLD=0
   --placeholder
   escaped_strings.ml
   --run
   escaped_strings
   %{dep:escaped_strings_runner.exe}
   inline-test-runner
   conformance)))

(rule
 (alias runtest)
 (enabled_if
  (>= %{ocaml_version} 5.2))
 (action
  (diff escaped_strings-exit.expected escaped_strings-exit)))

(rule
 (alias runtest)
 (enabled_if
  (>= %{ocaml_version} 5.2))
 (action
  (diff escaped_strings-log.expected escaped_strings-log)))

(rule
 (alias runtest)
 (enabled_if
  (>= %{ocaml_version} 5.2))
 (action
  (diff escaped_strings.ml.corrected.expected escaped_strings.ml.corrected)))

; chdir.ml leaves its process in a directory it deleted, so it runs in a
; process of its own: a later fixture that read the working directory
; would otherwise fail in its place. Windows cannot remove a process's
; working directory, so the fixture's rules are POSIX only.

(executable
 (name chdir_runner)
 (modules chdir_runner chdir)
 (libraries ppx_windtrap.runtime)
 (preprocess
  (pps ppx_windtrap)))

(rule
 (targets chdir-log chdir-exit chdir.ml.corrected)
 (enabled_if
  (<> %{os_type} Win32))
 (deps chdir.ml)
 (action
  (run
   %{dep:../../../support/drive/drive.exe}
   --mask
   full-log
   --env
   WINDTRAP_SLOW_THRESHOLD=0
   --placeholder
   chdir.ml
   --run
   chdir
   %{dep:chdir_runner.exe}
   inline-test-runner
   conformance)))

(rule
 (alias runtest)
 (enabled_if
  (<> %{os_type} Win32))
 (action
  (diff chdir-exit.expected chdir-exit)))

(rule
 (alias runtest)
 (enabled_if
  (<> %{os_type} Win32))
 (action
  (diff chdir-log.expected chdir-log)))

(rule
 (alias runtest)
 (enabled_if
  (<> %{os_type} Win32))
 (action
  (diff chdir.ml.corrected.expected chdir.ml.corrected)))


