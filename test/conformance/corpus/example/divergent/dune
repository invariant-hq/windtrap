; Two fixtures that diverged at the first measure and conform now,
; each with a runner of its own so its exit code and transcript are its
; own.
;
; functor.ml: module M () instantiated twice registers two passing
; tests with identical names/locations; windtrap renames the later
; duplicate and runs both. A conforming run passes with no correction,
; so the golden is the driver's placeholder.
;
; control_chars.ml: [%expect] payload with control characters and
; leading-space lines; matching follows upstream's line splitting and
; whitespace stripping, so it passes with no correction.

(executable
 (name conformance_runner)
 (modules conformance_runner functor)
 (libraries ppx_windtrap.runtime)
 (preprocess
  (pps ppx_windtrap)))

(rule
 (targets functor-log functor-exit functor.ml.corrected)
 (deps functor.ml)
 (action
  (run
   %{dep:../../../../support/drive/drive.exe}
   --mask
   full-log
   --env
   WINDTRAP_SLOW_THRESHOLD=0
   --placeholder
   functor.ml
   --run
   functor
   %{dep:conformance_runner.exe}
   inline-test-runner
   conformance)))

(rule
 (alias runtest)
 (action
  (diff functor-exit.expected functor-exit)))

(rule
 (alias runtest)
 (action
  (diff functor-log.expected functor-log)))

(rule
 (alias runtest)
 (action
  (diff functor.ml.corrected.expected functor.ml.corrected)))

(executable
 (name runner_control_chars)
 (modules runner_control_chars control_chars corpus_shim)
 (libraries ppx_windtrap.runtime)
 (preprocess
  (pps ppx_windtrap)))

(rule
 (targets control_chars-log control_chars-exit control_chars.ml.corrected)
 (deps control_chars.ml)
 (action
  (run
   %{dep:../../../../support/drive/drive.exe}
   --mask
   full-log
   --env
   WINDTRAP_SLOW_THRESHOLD=0
   --placeholder
   control_chars.ml
   --run
   control_chars
   %{dep:runner_control_chars.exe}
   inline-test-runner
   conformance)))

(rule
 (alias runtest)
 (action
  (diff control_chars-exit.expected control_chars-exit)))

(rule
 (alias runtest)
 (action
  (diff control_chars-log.expected control_chars-log)))

(rule
 (alias runtest)
 (action
  (diff control_chars.ml.corrected.expected control_chars.ml.corrected)))
