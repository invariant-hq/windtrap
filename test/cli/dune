(executable
 (name suite_main)
 (modules suite_main)
 (libraries windtrap unix))

(cram
 (applies_to :whole_subtree)
 (deps suite_main.exe))

(executable
 (name send_signal)
 (modules send_signal)
 (libraries unix))

(cram
 (applies_to signals)
 (enabled_if
  (<> %{os_type} Win32))
 (deps send_signal.exe))

; instrumented.t runs the mutation loop, which forks, over a suite whose
; one module is instrumented in every build.

(library
 (name mutant_subject)
 (modules mutant_subject)
 (preprocess
  (pps ppx_windtrap.mutate)))

(executable
 (name mutant_main)
 (modules mutant_main)
 (libraries windtrap mutant_subject))

(cram
 (applies_to instrumented)
 (enabled_if
  (<> %{os_type} Win32))
 (deps mutant_main.exe))

(cram
 (applies_to broadcast)
 (enabled_if
  (<> %{os_type} Win32))
 (deps mutant_main.exe))

(cram
 (applies_to nodune)
 (deps
  (package windtrap)
  coverage_ppx.exe
  mutate_ppx.exe))

(executable
 (name coverage_ppx)
 (modules coverage_ppx)
 (libraries ppxlib ppx_windtrap.coverage))

(executable
 (name mutate_ppx)
 (modules mutate_ppx)
 (libraries ppxlib ppx_windtrap.mutate))
