; Tests registered by (pps ppx_windtrap) in an executable's own modules
; are never run by dune: the guard must exit 2 for the undriven binary and
; stay silent on every driven path. See doc/dev/testing.md, "The five
; families".

; One stanza carries the fixture so both mains link the same module, a
; module of no library.

(executables
 (names undriven_main undriven_runner)
 (modules undriven_main undriven_runner inline_undriven)
 (libraries windtrap ppx_windtrap.runtime)
 (preprocess
  (pps ppx_windtrap)))

(rule
 (targets
  run-undriven-log
  run-undriven-exit
  run-driven-log
  run-driven-exit
  run-list-log
  run-list-exit
  run-byhand-log
  run-byhand-exit)
 (deps inline_undriven.ml)
 (action
  (run
   %{dep:../drive/drive.exe}
   --env
   WINDTRAP_SLOW_THRESHOLD=0
   --run
   run-undriven
   %{dep:undriven_main.exe}
   --run
   run-driven
   %{dep:undriven_runner.exe}
   inline-test-runner
   undriven
   --run
   run-list
   %{dep:undriven_runner.exe}
   inline-test-runner
   undriven
   -list-partitions
   --run
   run-byhand
   %{dep:undriven_runner.exe})))

(rule
 (alias runtest)
 (action
  (diff undriven-log.expected run-undriven-log)))

(rule
 (alias runtest)
 (action
  (diff undriven-exit.expected run-undriven-exit)))

(rule
 (alias runtest)
 (action
  (diff driven-log.expected run-driven-log)))

(rule
 (alias runtest)
 (action
  (diff driven-exit.expected run-driven-exit)))

(rule
 (alias runtest)
 (action
  (diff list-log.expected run-list-log)))

(rule
 (alias runtest)
 (action
  (diff list-exit.expected run-list-exit)))

(rule
 (alias runtest)
 (action
  (diff byhand-log.expected run-byhand-log)))

(rule
 (alias runtest)
 (action
  (diff byhand-exit.expected run-byhand-exit)))
