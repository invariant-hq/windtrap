(executable
 (name slow_knobs_runner)
 (modules slow_knobs_runner inline_slow_knobs)
 (libraries windtrap ppx_windtrap.runtime)
 (preprocess
  (pps ppx_windtrap)))

(rule
 (targets run-compact-log run-compact-exit run-verbose-log run-verbose-exit)
 (deps inline_slow_knobs.ml)
 (action
  (run
   %{dep:../drive/drive.exe}
   --mask
   slow
   --mask
   verbose
   --env
   WINDTRAP_SLOW_THRESHOLD=0.000000001
   --run
   run-compact
   %{dep:slow_knobs_runner.exe}
   inline-test-runner
   slow_knobs
   --run
   run-verbose
   %{dep:slow_knobs_runner.exe}
   --env
   WINDTRAP_VERBOSE=1
   inline-test-runner
   slow_knobs)))

(rule
 (alias runtest)
 (action
  (diff compact-log.expected run-compact-log)))

(rule
 (alias runtest)
 (action
  (diff compact-exit.expected run-compact-exit)))

(rule
 (alias runtest)
 (action
  (diff verbose-log.expected run-verbose-log)))

(rule
 (alias runtest)
 (action
  (diff verbose-exit.expected run-verbose-exit)))
