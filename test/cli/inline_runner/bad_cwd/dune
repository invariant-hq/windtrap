; A partition whose sources cannot be found must fail loudly and write no
; correction: run from a scratch cwd outside any project, it exits 1, and
; its block says why no correction was kept instead of offering one.
; See doc/dev/testing.md, "The five families".

(executable
 (name bad_cwd_runner)
 (modules bad_cwd_runner inline_bad_cwd)
 (libraries windtrap ppx_windtrap.runtime)
 (preprocess
  (pps ppx_windtrap)))

(rule
 (targets runner-log runner-exit)
 (deps inline_bad_cwd.ml)
 (action
  (run
   %{dep:../drive/drive.exe}
   --scratch-cwd
   --scratch-exe
   --probe
   inline_bad_cwd.ml.corrected
   --mask
   full-log
   --mask
   os-reason
   --env
   WINDTRAP_SLOW_THRESHOLD=0
   --run
   runner
   %{dep:bad_cwd_runner.exe}
   inline-test-runner
   bad_cwd)))

(rule
 (alias runtest)
 (action
  (diff runner-log.expected runner-log)))

(rule
 (alias runtest)
 (action
  (diff runner-exit.expected runner-exit)))
