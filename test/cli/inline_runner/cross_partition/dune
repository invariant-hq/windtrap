(executable
 (name cross_partition_runner)
 (modules cross_partition_runner crash stale)
 (libraries ppx_windtrap.runtime)
 (preprocess
  (pps ppx_windtrap)))

(executable
 (name drive_cross_partition)
 (modules drive_cross_partition)
 (libraries drive_harness unix))

; One rule runs both partitions, so the runs never race on .corrected files.

(rule
 (targets
  crash-log
  crash-exit
  crash-corrected
  stale-log
  stale-exit
  stale.ml.corrected
  junit-suites)
 (deps crash.ml stale.ml)
 (action
  (run ./drive_cross_partition.exe %{dep:cross_partition_runner.exe})))

(rule
 (alias runtest)
 (action
  (diff crash-exit.expected crash-exit)))

(rule
 (alias runtest)
 (action
  (diff crash-corrected.expected crash-corrected)))

(rule
 (alias runtest)
 (action
  (diff crash-log.expected crash-log)))

(rule
 (alias runtest)
 (action
  (diff stale-exit.expected stale-exit)))

(rule
 (alias runtest)
 (action
  (diff stale-log.expected stale-log)))

(rule
 (alias runtest)
 (action
  (diff stale.ml.corrected.expected stale.ml.corrected)))

(rule
 (alias runtest)
 (action
  (diff junit-suites.expected junit-suites)))
