[@@@ocaml.text "/*"]
module Windtrap_cov_________fixture_fun___ml =
  struct
    let ___windtrap_visit___ =
      let counts = Array.make 10 0 in
      Windtrap_coverage.register ~file:"./fixture_fun.ml"
        ~points:[|{
                    Windtrap_coverage.start_ofs = 202;
                    Windtrap_coverage.end_ofs = 207
                  };{
                      Windtrap_coverage.start_ofs = 240;
                      Windtrap_coverage.end_ofs = 245
                    };{
                        Windtrap_coverage.start_ofs = 270;
                        Windtrap_coverage.end_ofs = 275
                      };{
                          Windtrap_coverage.start_ofs = 304;
                          Windtrap_coverage.end_ofs = 309
                        };{
                            Windtrap_coverage.start_ofs = 337;
                            Windtrap_coverage.end_ofs = 348
                          };{
                              Windtrap_coverage.start_ofs = 351;
                              Windtrap_coverage.end_ofs = 365
                            };{
                                Windtrap_coverage.start_ofs = 389;
                                Windtrap_coverage.end_ofs = 395
                              };{
                                  Windtrap_coverage.start_ofs = 398;
                                  Windtrap_coverage.end_ofs = 408
                                };{
                                    Windtrap_coverage.start_ofs = 431;
                                    Windtrap_coverage.end_ofs = 447
                                  };{
                                      Windtrap_coverage.start_ofs = 431;
                                      Windtrap_coverage.end_ofs = 467
                                    }|] ~counts;
      (fun index -> Windtrap_coverage.visit counts index)
    let ___windtrap_post_visit___ point_index result =
      ___windtrap_visit___ point_index; result
  end
open Windtrap_cov_________fixture_fun___ml
[@@@ocaml.text "/*"]
let add a b = ___windtrap_visit___ 0; a + b
let curried a = fun b -> ___windtrap_visit___ 1; a + b
let annotated x : int= ___windtrap_visit___ 2; x + 1
let constrained x = (___windtrap_visit___ 3; x + 1 : int)
let arms =
  function
  | 0 -> (___windtrap_visit___ 4; "zero")
  | _ -> (___windtrap_visit___ 5; "nonzero")
let mixed x =
  function
  | 0 -> (___windtrap_visit___ 6; x)
  | n -> (___windtrap_visit___ 7; n + x)
let sequenced () =
  ___windtrap_visit___ 9;
  ___windtrap_post_visit___ 8 (print_string "a");
  print_string "b"
