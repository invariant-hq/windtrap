; A second instrumented executable, for the two things the four-site
; subject cannot show: the runtime's runaway hit-count budget killing a
; mutant that would otherwise spin forever — the only protection against a
; hanging mutant in this slice — and a sibling verdict file appearing
; beside another executable's.

(library
 (name mutate_loop_spinner)
 (modules spinner)
 (preprocess
  (pps ppx_windtrap.mutate)))

(executable
 (name runaway_main)
 (modules runaway_main)
 ; windtrap_mutation: the suite runs under WINDTRAP_MUTATE=1, and the
 ; loop only answers where its library is linked (see lib/mutation/dune).
 (libraries windtrap windtrap_mutation mutate_loop_spinner))
