; The JUnit suite's XML well-formedness oracle; stdlib only.

(library
 (name xml_check)
 (modules xml_check))

; The meta suites drive Run.execute in-process, which refuses to nest
; inside a run, so they are plain executables over this harness.

(library
 (name harness)
 (modules harness)
 (libraries windtrap unix))

