; The unit suite: one test_<module>.ml per lib module, each its own
; executable ending in its own `run` — address one module by building
; and running it, `dune exec test/unit/test_gen.exe -- -f shrink`. The
; plural stanza declares them in one block; dune links each executable
; from its own module's closure and runs them in parallel, where
; windtrap's runner is deliberately sequential within one process.
;
; The four meta suites below drive Runner.execute in-process with
; synthetic configs (the sanctioned way to test runner behavior with
; windtrap itself); execute refuses to nest inside an active run, so
; they stay plain executables over the hand-rolled harness.

(tests
 (names
  test_pp
  test_text
  test_clock
  test_tag
  test_loc
  test_env
  test_path_ops
  test_seed
  test_shrink_tree
  test_atomic_file
  test_testable
  test_failure
  test_diff
  test_check
  test_gen
  test_capture
  test_property
  test_snapshot
  test_stateful
  test_test_tree
  test_render
  test_render_junit
  test_render_github
  test_cli
  test_driver)
 (modules
  test_pp
  test_text
  test_clock
  test_tag
  test_loc
  test_env
  test_path_ops
  test_seed
  test_shrink_tree
  test_atomic_file
  test_testable
  test_failure
  test_diff
  test_check
  test_gen
  test_capture
  test_property
  test_snapshot
  test_stateful
  test_test_tree
  test_render
  test_render_junit
  test_render_github
  test_cli
  test_driver)
 (libraries windtrap windtrap_runtime unix harness render_fixtures xml_check)
 ; test_render's golden transcripts are snapshot baselines, not literals
 ; in the source. They are inputs to the run, so dune must know about
 ; them or a sandboxed action cannot read them.
 (deps
  (glob_files_rec __snapshots__/**)))

; Modules shared by more than one test file are libraries, not extra
; entries in a test stanza's (modules ...) — the same shape harness
; already has. Each is a single module named after its library, so call
; sites spell it exactly as they would a local module.

; Synthetic run data for the four renderer suites (test_render,
; test_render_junit, test_render_github, test_driver).

(library
 (name render_fixtures)
 (modules render_fixtures)
 (libraries windtrap))

; The JUnit suite's XML well-formedness oracle. Stdlib only, on purpose:
; it is a test asset, never a dependency of the renderer it checks.

(library
 (name xml_check)
 (modules xml_check))

; The meta suites drive the ambient slot and Runner.execute in-process
; with synthetic configs; execute refuses to nest inside an active run,
; so each is a plain executable over the shared hand-rolled harness.
; The harness links windtrap for its output dialect only (Pp styling,
; Env's color resolution, Render's duration format via Private) — its
; summary line must carry the same bytes as a windtrap suite's.

(library
 (name harness)
 (modules harness)
 (libraries windtrap unix))

; WINDTRAP_COVERAGE=off: these four assert on transcripts byte for byte,
; and lib/ is instrumented — under `--instrument-with` every run they
; drive would append an inline coverage line about the core, which is
; not what any of them is measuring. The at_exit dump still writes, so
; their coverage still reaches `dune build @cover`.

(tests
 (names test_run test_runner test_ppx_runtime test_windtrap)
 (modules test_run test_runner test_ppx_runtime test_windtrap)
 ; ppx_windtrap.runtime and .config are test_ppx_runtime's subjects: the
 ; inline runtime lives there (Ppx_windtrap_runtime.Ppx_runtime), not in
 ; the core, and .config exposes the ambient Expect_test_config under
 ; exactly the top-level name generated code references.
 (libraries windtrap ppx_windtrap.runtime ppx_windtrap.config unix harness)
 (action
  (setenv
   WINDTRAP_COVERAGE
   off
   (run %{test}))))
