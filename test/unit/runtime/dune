; test_coverage registers files of its own, which must stay out of the
; project's merge, so its dump goes to WINDTRAP_COVERAGE_FILE, set on the
; action: the destination is resolved at the first registration, before the
; test's own code runs.

(executable
 (name coverage_child)
 (modules coverage_child)
 (libraries windtrap_runtime unix))

(test
 (name test_coverage)
 (modules test_coverage)
 (libraries windtrap windtrap_runtime windtrap_test_support unix)
 (deps coverage_child.exe)
 (action
  (setenv
   WINDTRAP_COVERAGE_FILE
   test_coverage.coverage
   (run %{test}))))

(test
 (name test_instr)
 (modules test_instr)
 (libraries windtrap windtrap_runtime windtrap_test_support)
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_instr.ml test_instr.ml.corrected))))

(executable
 (name mutate_child)
 (modules mutate_child)
 (libraries windtrap_runtime))

(test
 (name test_mutate)
 (modules test_mutate)
 (libraries windtrap windtrap_runtime windtrap_test_support)
 (deps mutate_child.exe)
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_mutate.ml test_mutate.ml.corrected))))

(test
 (name test_verdicts)
 (modules test_verdicts)
 (libraries windtrap windtrap_runtime)
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_verdicts.ml test_verdicts.ml.corrected))))
