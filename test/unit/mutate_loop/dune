; subject is instrumented unconditionally so its mutants exist in a plain
; runtest build, and plain_main links no instrumented module so the seam
; must decline by name.

(library
 (name mutate_loop_subject)
 (modules subject)
 (preprocess
  (pps ppx_windtrap.mutate)))

(executable
 (name suite_main)
 (modules suite_main)
 (libraries windtrap windtrap_runtime mutate_loop_subject unix))

(executable
 (name plain_main)
 (modules plain_main)
 (libraries windtrap))

; The mutation loop forks, and Windows has no fork: the loop refuses there.
; The scenarios share suite_main.exe's one verdict file, which each removes
; and reads back, so two at once read each other's: -j 1 outranks a
; WINDTRAP_JOBS in the environment.

(test
 (package ppx_windtrap)
 (name test_mutate_loop)
 (modules test_mutate_loop)
 (enabled_if
  (<> %{os_type} Win32))
 (libraries windtrap windtrap_runtime windtrap_test_support unix)
 (deps
  suite_main.exe
  plain_main.exe
  inline/runner_main.exe
  inline/inline_armed.ml
  runaway/runaway_main.exe
  (glob_files ../../support/preload/*.so))
 (action
  (run %{test} -j 1)))
