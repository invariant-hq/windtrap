; `windtrap mutants` end to end: bin/main.exe over synthetic verdict files
; and over two instrumented executables that disagree about calc.ml, a dep
; because the suite replants it in a scratch project. See
; doc/dev/testing.md, "The five families".

(test
 (name test_mutants_cmd)
 (modules test_mutants_cmd)
 (libraries windtrap windtrap_runtime windtrap_test_support unix)
 (deps ../../../bin/main.exe pins_add.exe pins_sub.exe calc.ml))

(library
 (name mutcli_fixture)
 (modules calc)
 (preprocess
  (pps ppx_windtrap.mutate)))

(executable
 (name pins_add)
 (modules pins_add)
 (libraries windtrap mutcli_fixture))

(executable
 (name pins_sub)
 (modules pins_sub)
 (libraries windtrap mutcli_fixture))
