; The run half is every test family and every example (the merges read
; every dump under _build); (universe) makes the cheap aggregate re-run on
; every build.

(rule
 (alias self-cover)
 (deps
  (alias_rec runtest)
  (alias_rec ../examples/runtest)
  (universe))
 (action
  (run %{bin:windtrap} coverage --min 84)))

(rule
 (alias self-mutate)
 (deps
  (alias_rec runtest)
  (alias_rec ../examples/runtest)
  (universe))
 (action
  (run %{bin:windtrap} mutants)))
