; Windtrap's own verdicts, opt-in and tree-wide: the merges read every
; dump under _build, so the run half is ../runtest, and (universe) makes
; the cheap aggregate re-run on every build. See doc/dev/testing.md,
; "Windtrap under its own instrumentation".

(rule
 (alias self-cover)
 (deps
  (alias_rec ../runtest)
  (universe))
 (action
  (run %{bin:windtrap} coverage --min 84)))

(rule
 (alias self-mutate)
 (deps
  (alias_rec ../runtest)
  (universe))
 (action
  (run %{bin:windtrap} mutants)))
