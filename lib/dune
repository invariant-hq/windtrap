; Both backends instrument it for windtrap's own coverage and mutation
; aliases; the modules that judge mutants opt out with
; [@@@mutate exclude_file].

(library
 (name windtrap)
 (public_name windtrap)
 (libraries unix windtrap_runtime)
 (instrumentation
  (backend ppx_windtrap.coverage))
 (instrumentation
  (backend ppx_windtrap.mutate))
 (foreign_stubs
  (language c)
  (names capture_stubs os_stubs)))
