; The coverage walkthrough (doc/manual/coverage.md): one stanza
; on the library under test, committed once and inert without the flag —
; this plain `dune runtest` runs uninstrumented, with zero overhead and
; no coverage output. Two commands, the instrumented run and the merge:
;
;   dune runtest --force --instrument-with ppx_windtrap.coverage
;   dune exec windtrap -- coverage --min 80      (-u for the excerpts)
;
; The Sub and Mul arms in calc.ml are deliberately untested: instrumented
; runs report them as the uncovered lines.

(library
 (name windtrap_example_coverage)
 (modules calc)
 (instrumentation
  (backend ppx_windtrap.coverage)))

(test
 (name test_calc)
 (modules test_calc)
 (libraries windtrap windtrap_example_coverage))
