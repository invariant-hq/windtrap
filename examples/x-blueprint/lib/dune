; The library under test: two inert instrumentation stanzas, committed
; once (zero overhead until --instrument-with, or the workspace's
; instrument_with in ../dune-workspace, asks for them) and no PPX or
; test code in lib/ itself. Each backend is named by its own rewriter,
; so an instrumented library links that runtime and nothing else.

(library
 (name windtrap_example_blueprint)
 (instrumentation
  (backend ppx_windtrap.coverage))
 (instrumentation
  (backend ppx_windtrap.mutate)))
