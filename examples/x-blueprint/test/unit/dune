; Both suites declare properties, and the env_var deps make them react
; to a seed or a case count set in the environment: `WINDTRAP_SEED=…
; dune runtest` replays on a warm tree without --force.

(test
 (name test_slug)
 (modules test_slug)
 (libraries windtrap windtrap_example_blueprint)
 (deps
  (env_var WINDTRAP_SEED)
  (env_var WINDTRAP_PROP_COUNT)))

; test_stats holds an expect literal: its stanza runs the suite with
; --corrected and diffs the corrected file, so a stale render shows as a
; diff under `dune runtest` and `dune promote` accepts it.

(test
 (name test_stats)
 (modules test_stats)
 (libraries windtrap windtrap_example_blueprint)
 (deps
  (env_var WINDTRAP_SEED)
  (env_var WINDTRAP_PROP_COUNT))
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_stats.ml test_stats.ml.corrected))))
