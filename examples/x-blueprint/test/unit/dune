; THE windtrap suite: one test stanza per file, one file per source
; module. test_stats holds an expect literal: its stanza runs the suite
; with --corrected and diffs the corrected file, so a stale render
; shows as a diff under `dune runtest` and `dune promote` accepts it.

(test
 (name test_slug)
 (modules test_slug)
 (libraries windtrap windtrap_example_blueprint))

(test
 (name test_stats)
 (modules test_stats)
 (libraries windtrap windtrap_example_blueprint)
 (action
  (progn
   (run %{test} --corrected)
   (diff? test_stats.ml test_stats.ml.corrected))))
