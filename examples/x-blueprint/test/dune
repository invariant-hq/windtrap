; Both aliases need (universe): the .coverage and .mutants files are
; written by test executables at exit and are not declarable
; dependencies, so it makes the milliseconds-cheap merge re-run on every
; build.

(rule
 (alias cover)
 (deps
  (alias_rec runtest)
  (universe))
 (action
  (run %{bin:windtrap} coverage --min 80)))

(rule
 (alias mutate)
 (deps
  (alias_rec runtest)
  (universe))
 (action
  (run %{bin:windtrap} mutants)))
