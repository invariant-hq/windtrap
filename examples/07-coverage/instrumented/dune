; The example as `--instrument-with ppx_windtrap.coverage` builds it, for
; the transcripts of doc/manual/coverage.md, which the tree's plain build
; cannot otherwise show: the library preprocessed with the backend, each
; module under the example's path (-loc-filename), and the suites as
; executables that `dune runtest` never runs. A dune project of its own,
; so that its library keeps the example's name.

(copy_files ../*.ml)

(library
 (name windtrap_example_coverage)
 (modules calc half_a half_b)
 (preprocess
  (per_module
   ((pps ppx_windtrap.coverage -loc-filename=examples/07-coverage/calc.ml)
    calc)
   ((pps ppx_windtrap.coverage -loc-filename=examples/07-coverage/half_a.ml)
    half_a)
   ((pps ppx_windtrap.coverage -loc-filename=examples/07-coverage/half_b.ml)
    half_b))))

(executables
 (names test_calc test_a test_b)
 (modules test_calc test_a test_b)
 (libraries windtrap windtrap_example_coverage))
