; The example with the edit doc/manual/running-tests.md makes to show a
; failure: the server stops answering pings. Built, never run as a test;
; the page's transcripts run it. server_tests.ml is a copy, so a failure
; block can print its source line, and runtest keeps it equal to the
; example's.

(copy_files ../{db,db_tests,gpu_tests,process_tests,test_storage}.ml)

(executable
 (name test_storage)
 (libraries windtrap))

(rule
 (alias runtest)
 (action
  (diff server_tests.ml ../server_tests.ml)))
