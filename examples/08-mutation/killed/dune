; The example with the test doc/manual/mutation.md tells the reader to
; add, built as `--instrument-with ppx_windtrap.mutate` builds it: the
; library preprocessed with the backend under the example's path, and the
; suite as an executable that `dune runtest` never runs. A dune project of
; its own, so that its library keeps the example's name.

(copy_files ../calc.ml)

(library
 (name windtrap_example_mutation)
 (modules calc)
 (preprocess
  (pps ppx_windtrap.mutate -loc-filename=examples/08-mutation/calc.ml)))

(executable
 (name test_calc)
 (modules test_calc)
 (libraries windtrap windtrap_example_mutation))
