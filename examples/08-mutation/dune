(library
 (name windtrap_example_mutation)
 (modules calc)
 (instrumentation
  (backend ppx_windtrap.mutate)))

(test
 (name test_calc)
 (modules test_calc)
 (libraries windtrap windtrap_example_mutation))

(rule
 (alias mutate)
 (deps
  (alias_rec runtest)
  (universe))
 (action
  (run %{bin:windtrap} mutants)))
